generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ระบบบันทึก Order กุ้ง (นับเป็นรายวัน)
//
//   Order (1 บ่อ / 1 วัน)
//     └── OrderItem (ไซซ์ละ 1 แถว แต่ละไซซ์ส่งคนละที่ได้)
//
// ตัวอย่าง: วัน 10/10/69 บ่อจรัญ
//   66-70   5,289.59 กก. × 155 → โรงงาน ก
//   96-100    490.70 กก. × 120 → กทม.
//   totalWeight  = รวมน้ำหนักทุกไซซ์
//   แต่ละไซซ์มี 2 ราคา (น้ำหนักเดียวกัน)
//     ราคาซื้อ  buyPricePerKg → buyAmount = น้ำหนัก × ราคาซื้อ  (จ่ายเจ้าของบ่อ)
//     ราคาขาย  pricePerKg    → amount    = น้ำหนัก × ราคาขาย  (เก็บจากโรงงาน)
//   totalAmount  = รวมยอดขายทุกไซซ์ (ยอดที่เก็บจากโรงงาน/ผู้รับซื้อ)
//   buyTotal     = รวมยอดซื้อทุกไซซ์ (ราคาบ่อ ก่อนหักส่วนต่าง)
//   marginAmount = buyTotal × 1.5%  หักจากเจ้าของบ่อ (เฉพาะ order ที่เปิด includeMargin, ไม่เปิด = 0)
//   grandTotal   = buyTotal − marginAmount (ยอดจ่ายเจ้าของบ่อ)
//   profit       = totalAmount − grandTotal (กำไร)
//   ยอดเงินทุกตัวปัดเป็นบาทเต็ม

// ======================================================
// Order = รายการซื้อขาย 1 บ่อ ใน 1 วัน
// ======================================================
model Order {
  id Int @id @default(autoincrement())

  // ---- ข้อมูลทั่วไป (ผู้ใช้กรอก) ----
  orderDate DateTime @db.Date // วันที่ของ order (ใช้นับรายวัน)
  pondName  String            // ชื่อบ่อ / เจ้าของบ่อ เช่น "จรัญ"
  note      String?

  // ---- ยอดเงิน (ระบบคำนวณให้ ห้ามกรอกเอง) ----
  totalWeight   Decimal @db.Decimal(12, 2) // รวมน้ำหนักทุกไซซ์ (กก.)
  totalAmount   Decimal @db.Decimal(14, 2) // รวมยอดขายทุกไซซ์ = ยอดที่เก็บจากโรงงาน
  buyTotal      Decimal @db.Decimal(14, 2) // รวมยอดซื้อทุกไซซ์ (ก่อนหักส่วนต่าง)
  includeMargin Boolean @default(false)    // order นี้หักส่วนต่างหรือไม่
  marginRate    Decimal @default(1.5) @db.Decimal(5, 2) // % ส่วนต่าง
  marginAmount  Decimal @db.Decimal(14, 2) // ส่วนต่างที่หักจากเจ้าของบ่อ (ไม่หัก = 0)
  grandTotal    Decimal @db.Decimal(14, 2) // buyTotal − marginAmount = ยอดจ่ายเจ้าของบ่อ
  profit        Decimal @db.Decimal(14, 2) // totalAmount − grandTotal = กำไร

  // ---- 2 ปุ่มเช็กสถานะเงิน ----
  isPaidToFarmer Boolean   @default(false) // จ่ายเงินเจ้าของบ่อแล้วหรือยัง
  paidToFarmerAt DateTime?
  isReceived     Boolean   @default(false) // [ระบบคำนวณ] รับเงินครบทุกปลายทางแล้วหรือยัง (ติ๊กที่ OrderItem)
  receivedAt     DateTime?                 // [ระบบคำนวณ] เวลาที่รับครบ (ครั้งล่าสุด)

  // ---- ยกเลิก (แทนการลบจริง) ----
  isCancelled Boolean   @default(false)
  cancelledAt DateTime?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderDate])
  @@index([isCancelled])
  @@map("orders")
}

// ======================================================
// OrderItem = ไซซ์ 1 แถวใน Order
// ======================================================
model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  size        String                     // เช่น "66-70" (ระบบจัดรูปแบบให้ "66 - 70" → "66-70")
  destination String?                    // ไซซ์นี้ส่งไปไหน เช่น "โรงงาน ก", "กทม."
  weight        Decimal @db.Decimal(12, 2) // น้ำหนัก (กก.) ใช้ทั้งฝั่งซื้อและขาย
  buyPricePerKg Decimal @db.Decimal(10, 2) // ราคาซื้อจากเจ้าของบ่อ ต่อ กก.
  buyAmount     Decimal @db.Decimal(14, 2) // [ระบบคำนวณ] weight × buyPricePerKg
  pricePerKg    Decimal @db.Decimal(10, 2) // ราคาขาย (โรงงานรับซื้อ) ต่อ กก.
  amount        Decimal @db.Decimal(14, 2) // [ระบบคำนวณ] weight × pricePerKg = ยอดเก็บจากปลายทางนี้

  // ---- รับเงินแยกตามปลายทาง (ติ๊กพร้อมกันทุกไซซ์ที่ส่งไปที่เดียวกันใน order นี้) ----
  isReceived Boolean   @default(false) // ได้รับเงินจากปลายทางนี้แล้วหรือยัง
  receivedAt DateTime?

  @@index([size])
  @@index([orderId])
  @@map("order_items")
}
